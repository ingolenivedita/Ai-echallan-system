# =========================================================
#  AI Driven Camera Detected RTO E-Challan System
#  Copy this file to `.env` and paste your keys after the "=".
#  Leave a key EMPTY to keep that service in DEMO MODE.
#  Secrets stay on the backend. Never add them to the frontend.
# =========================================================

# ---------------------------------------------------------
# AI API  (https://console.groq.com/keys)
# ---------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=

# ---------------------------------------------------------
# ANPR / NUMBER PLATE API  (https://app.platerecognizer.com)
# ---------------------------------------------------------
PLATE_RECOGNIZER_API_KEY=
PLATE_RECOGNIZER_REGIONS=in

# ---------------------------------------------------------
# SMS API  (https://www.fast2sms.com/dashboard/dev-api)
# ---------------------------------------------------------
SMS_API_KEY=
SMS_SENDER_ID=
SMS_PROVIDER=Fast2SMS

# ---------------------------------------------------------
# PAYMENT API  (https://dashboard.razorpay.com - Test Mode)
# ---------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
MONGO_URI=
MONGO_DB_NAME=rto_echallan

# ---------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DETECTION_INTERVAL_SECONDS=8
DETECTION_COOLDOWN_SECONDS=90
DETECTION_MIN_CONFIDENCE=0.55
AUTO_CHALLAN=true
