# Frontend configuration.
# NEVER put API secrets here - anything with a VITE_ prefix is shipped to the
# browser. All external API keys live in backend/.env only.

# Backend URL used by the Vite dev server proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: set an absolute API base URL for a production build where the
# frontend is served from a different origin than the API.
# VITE_API_URL=https://rto-api.example.gov.in
